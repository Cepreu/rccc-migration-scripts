-- 2022-05-10

SELECT * FROM CatalogWRK 
WHERE 
	ListPriceCurrency IN ('USD','CAD')
	AND Plan = 'Monthly - Contract'
	AND CatID IS NOT NULL
ORDER BY CatID,ProductFamily
;

SELECT usd.*,usd.ListPrice AS USDListPrice,cad.ListPrice AS CADListPrice
FROM CatalogWRK usd
LEFT JOIN  CatalogWRK cad 
ON cad.ExtID = usd.ExtID
	AND cad.ListPriceCurrency = 'CAD'
WHERE 
	usd.ListPriceCurrency = 'USD'
	AND usd.Plan = 'Monthly - Contract'
	AND usd.CatID IS NOT NULL
ORDER BY usd.CatID, usd.ProductFamily
;

SELECT field2,usd.*,usd.ListPrice AS USDListPrice
FROM CatalogWRK usd
LEFT JOIN standalone
ON usd.CatID=ICSKU
AND 
(
	usd.ProductFamily=&quot;Overage&quot; AND LicenseType=&quot;Usage&quot; 
	OR 
    usd.ProductFamily != 'Overage' AND LicenseType != 'Usage'
)
WHERE 
	usd.ListPriceCurrency = 'USD'
	AND usd.Plan = 'Monthly - Contract'
	AND usd.CatID IS NOT NULL
	AND usd.CatID NOT IN (SELECT DISTINCT SKU FROM CatalogSFDC)
	AND usd.&quot;Product:CreatedDate&quot; != '5/6/2022'
ORDER BY usd.CatID, usd.ProductFamily
;

SELECT usd.*,usd.ListPrice AS USDListPrice,cad.ListPrice AS CADListPrice
FROM CatalogWRK usd
LEFT JOIN  CatalogWRK cad 
ON cad.ExtID = usd.ExtID
	AND cad.ListPriceCurrency = 'CAD'
WHERE 
	usd.ListPriceCurrency = 'USD'
	AND usd.Plan = 'Monthly - Contract'
	AND usd.CatID IS NOT NULL
	AND usd.CatID NOT IN (SELECT DISTINCT SKU FROM CatalogSFDC)
	AND usd.&quot;Product:CreatedDate&quot; != '5/6/2022'
ORDER BY usd.CatID, usd.ProductFamily
;

