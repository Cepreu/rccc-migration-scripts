        FROM Entitlements_DWH e	
            INNER JOIN BatchAccounts b ON e.USERID=b.EID
        WHERE b.batchID='test1'
            AND e.STATUS_NAME='Active'
            AND (e.END_DATE &gt; date('now') OR e.END_DATE IS NULL OR  e.END_DATE ='') ;
			
SELECT c.* 
        FROM nic_case_items c
            INNER JOIN BatchAccounts b ON c.accountID = b.EID
        WHERE b.batchID='test1';
		
--2022-06-22
 SELECT
        EnterpriseAccountID AS ENTERPRISE_ACCOUNT_ID,	
        BillingID AS BILLING_ACCOUNT_ID,
        a.Brand AS ACCT_BRANDID,
        a.Brand AS BRANDNAME,
        PriceperSeatCurrency AS CURRENCY,
        a.inContactBUID,
        888 AS PACKAGE_ID, ----?
        PaymentPlan AS BILLING_TERM,
        10 AS SPENDING_LIMIT, ----?
        a.&quot;No.ofInContactSeats&quot;,
        nic.ContactCenterNumber,
        DefaultTimeZone,
        GeoRegion,
        ImplementationTeam
    FROM accounts_sfdc a
        INNER JOIN BatchAccounts b ON b.EID = EnterpriseAccountID
        INNER JOIN nic_cases nic ON nic.UID = EnterpriseAccountID
    WHERE b.batchID='test1' -----?
    GROUP BY EnterpriseAccountID
;	


SELECT
      EnterpriseAccountID AS ENTERPRISE_ACCOUNT_ID,	
      BillingID AS BILLING_ACCOUNT_ID,
      a.AccountName,
      b.batchID, 
      a.Brand AS ACCT_BRANDID,
      a.Brand AS BRANDNAME,
      PriceperSeatCurrency AS CURRENCY,
      a.inContactBUID AS INCONTACT_BUID,
      1000 AS PACKAGE_ID,
      PaymentPlan AS BILLING_TERM,
      2000 AS SPENDING_LIMIT,
      a.&quot;No.ofInContactSeats&quot;,
      nic.ContactCenterNumber,
      DefaultTimeZone,
      GeoRegion,
      ImplementationTeam
  FROM accounts_sfdc a
    INNER JOIN BatchAccounts b ON b.EID = EnterpriseAccountID
    INNER JOIN nic_cases nic ON nic.UID = EnterpriseAccountID
  WHERE b.batchID='test1'
  GROUP BY EnterpriseAccountID
;
		
	
SELECT
      EnterpriseAccountID AS ENTERPRISE_ACCOUNT_ID,	
      BillingID AS BILLING_ACCOUNT_ID,
      b.AccountName,
      b.batchID, 
      1210 AS ACCT_BRANDID,
      a.Brand AS BRANDNAME,
      PriceperSeatCurrency AS CURRENCY,
      a.inContactBUID AS INCONTACT_BUID,
      ? AS PACKAGE_ID,
      PaymentPlan AS BILLING_TERM,
      ? AS SPENDING_LIMIT,
      a.&quot;No.ofInContactSeats&quot;,
      nic.ContactCenterNumber,
      DefaultTimeZone,
      GeoRegion,
      ImplementationTeam
  FROM accounts_sfdc a
    INNER JOIN BatchAccounts b ON b.EID = EnterpriseAccountID
    INNER JOIN nic_cases nic ON nic.UID = EnterpriseAccountID
  WHERE b.batchID='test1'
  GROUP BY EnterpriseAccountID  
  ;
  
  SELECT * FROM invoiceLines WHERE BILLING_MONTH='2022-01-01' AND USERID=180611037.0;
  
SELECT b.EXT_PRODUCT_ID, b.Category, b.ITEM_NAME, b.ITBS_NAME, b.QNTY_THRESHOLD, b.OldPrice, 
	CASE b.CURRENCY_CODE WHEN 'USD' THEN round(PRICEUSD,2) WHEN 'CAD' THEN round(PRICE,2) END PRICE, 
	CASE b.CURRENCY_CODE WHEN 'USD' THEN round(DiscountUSD,2) WHEN 'CAD' THEN round(Discount,2) END DISCOUNT, 
	b.CURRENCY_CODE AS CURRENCY, round(NiCPrice,2) NiCPrice, b.PARENT, b.ProductFamily, b.batchID, e.USERID AS ENTERPRISE_ACCOUNT_ID, e.ID, e.START_DATE, e.END_DATE, e.COUNTRY_ID, e.COUNTRY_NAME, e.BILLING_ITEM_ID, e.RETAIL_PRICE, e.DISCOUNT_VALUE, e.QNTY_THRESHOLD, e.ProductFamily AS TYPE_NAME, e.STATUS_NAME 
FROM BatchEntitlements b 
LEFT JOIN Entitlements_DWH e ON b.ID=e.ID 
WHERE eid=400917026
ORDER BY b.AccountName, b.QNTY_THRESHOLD DESC, cast(b.EXT_PRODUCT_ID AS INTEGER), b.EXT_PRODUCT_ID, b.Category 
;

 
  SELECT CatalogID || '-' || CASE WHEN FeatureID='' THEN '000' ELSE FeatureID END || '-' || CASE WHEN FeatureDetailID='' THEN '000' ELSE FeatureDetailID END AS SKU, Product, Quantity, Amount, Amount/Quantity AS Price 
  FROM RCMRCSummary 
  WHERE Account=4601042
  AND BillingPeriodStart='2022-01-01' AND ProductType='MRC' ORDER BY cast(CatalogID as INTEGER), CatalogID;
  
  
  --2022-06-27
      SELECT 
        *,
        CatalogID || '-' || 
          CASE WHEN FeatureID='' THEN '000' ELSE FeatureID END || '-' || 
          CASE WHEN FeatureDetailID='' THEN '000' ELSE FeatureDetailID END 
        AS SKU,
        Amount/Quantity AS Price
    FROM RCMRCSummary
    WHERE Account=4598375
        AND BillingPeriodStart='2022-01-01'
        AND ProductType='MRC'
    ORDER BY cast(CatalogID as INTEGER), CatalogID
  ;
  
 SELECT COUNT(DISTINCT UID) 
  FROM nic_cases
  WHERE 
	subject LIKE 'Change Order %'
AND
	CreatedDate BETWEEN '2022-03-17'  AND '2022-06-17';
  
 SELECT UID
 FROM nic_cases
 WHERE 
	subject LIKE 'Change Order %'
AND
	CreatedDate BETWEEN '2022-03-17'  AND '2022-06-17'
GROUP BY UID
HAVING COUNT(*)=1;
  
  
  
  
 --2022-07-05
     --INSERT INTO BatchEntitlements (EID, UID, BID, AccountName, ID, EXT_PRODUCT_ID, ITEM_NAME, ITBS_NAME, RETAIL_PRICE, MDURATION, CURRENCY_CODE, OldPrice, QNTY_THRESHOLD, PriceUSD, Price, DiscountUSD, Discount, NiCPrice, Category, PARENT, ProductFamily, batchID) 
	 SELECT DISTINCT b.EID, b.UID, b.BID, b.AccountName, e.ID, e.EXT_PRODUCT_ID, 
	 lc.PRODUCT_NAME, 
	 e.ITEM_NAME, 
	 e.RETAIL_PRICE, e.MDURATION, e.CURRENCY_CODE, 
	 (e.RETAIL_PRICE-e.DISCOUNT_VALUE) / CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END, 
	 e.QNTY_THRESHOLD, lc.PRICE_USD, lc.PRICE_CAD, lc.PRICE_USD - (e.RETAIL_PRICE - e.DISCOUNT_VALUE) / CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END, 
	 lc.PRICE_CAD - (e.RETAIL_PRICE - e.DISCOUNT_VALUE) / CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END, lc.NIC_PRICE, lc.L_CATEGORY, lc.PARENT, e.ProductFamily, 'test1' 
	 FROM Entitlements_DWH e 
	 INNER JOIN BatchAccounts b ON EID=USERID AND b.batchID='test1' 
	 LEFT JOIN CatalogSFDC lc ON 
		( e.ITEM_NAME=lc.PRODUCT_NAME OR e.EXT_PRODUCT_ID IN ('308-8-167', '309-11-171', '309-11-172', '309-565-000', '310-557-000', '500-617-000', '1012-150-000', '1032-173-000', '1032-174-000', '1032-175-000', '1032-487-000', '1032-493-000', '1032-494-000', '1032-572-000', '1032-573-000', '1032-574-000', '1270-136-000', '1500-000-000', '1503-693-000', '1503-694-000', '1561-50-000', '1561-55-000', '3347-21-000', '3465-22-000', '3465-521-000', '3465-523-000', '3465-1227-000', '4058-000-000', '4100-533-000', '4100-534-000', '4100-701-000', '4101-537-000', '4101-643-000', '4102-538-000', '4102-539-000', '4102-642-000', '4102-829-000', '4104-541-000', '4104-644-000', '4105-542-000', '4106-543-000', '4107-645-000', '4108-561-000', '4109-673-000', '610064-302-000') ) 
		AND e.EXT_PRODUCT_ID=lc.SKU 
		AND 
			(e.ProductFamily!='Overage' AND lc.PRODUCT_FAMILY!='Overage' OR e.ProductFamily='Overage' AND lc.PRODUCT_FAMILY='Overage') 
	WHERE STATUS_NAME='Active' AND (END_DATE = '' OR END_DATE IS NULL OR END_DATE &gt; date('now')) and USERID='171423037'
	ORDER BY b.EID, e.EXT_PRODUCT_ID ;
	
	SELECT 
        b.EXT_PRODUCT_ID,
        b.Category,
        b.ITEM_NAME,
        b.ITBS_NAME,
        b.QNTY_THRESHOLD,
        b.OldPrice,
        CASE b.CURRENCY_CODE WHEN 'USD' THEN round(PRICEUSD,2) WHEN 'CAD' THEN round(PRICE,2) END PRICE,
        CASE b.CURRENCY_CODE WHEN 'USD' THEN round(DiscountUSD,2) WHEN 'CAD' THEN round(Discount,2) END DISCOUNT,
        b.CURRENCY_CODE AS CURRENCY,
        round(NiCPrice,2) NiCPrice,
        b.PARENT,
        b.ProductFamily,
        b.batchID
    FROM BatchEntitlements b
    WHERE eid=171423037
    ORDER BY b.AccountName, b.QNTY_THRESHOLD DESC, cast(b.EXT_PRODUCT_ID AS INTEGER), b.EXT_PRODUCT_ID, b.Category;
	
	
