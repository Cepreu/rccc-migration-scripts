<table schema="main" name="invoices" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="50"/><column index="2" value="75"/><column index="3" value="120"/><column index="4" value="69"/><column index="5" value="131"/><column index="6" value="105"/><column index="7" value="140"/><column index="8" value="119"/><column index="9" value="116"/><column index="10" value="96"/><column index="11" value="269"/><column index="12" value="73"/><column index="13" value="138"/><column index="14" value="138"/><column index="15" value="164"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">select count(*), sum(quantity), sum(amount) from RCMRCSummary
where BillingPeriodStart='2025-10-01'
and Product LIKE 'Data Storage - A%'
;


select count(*), sum(quantity), sum(amount) from RCMRCSummary
where BillingPeriodStart='2025-10-01'
and Product LIKE '%NICE Screen recording%'
;


select count(distinct Customer) from RCMRCSummary
where BillingPeriodStart='2025-10-01'
;


select * from batchCands where eid not in (select eid from BatchAccounts where batchID  like &quot;Batch#4%&quot;)
;

select eid from batchCands group by eid having count(*)&gt;1;


select count(*) from 
BatchAccounts where batchID  like &quot;Batch#4%&quot;
;

create table batchCands (eid INTEGER, batchID VARSCHAR (100));

