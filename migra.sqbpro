--2022-06-06
SELECT 
r.USERID,
a.AccountName,
r.EXT_PRODUCT_ID,
r.ITEM_NAME,
r.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
r.QNTY_THRESHOLD,
r.ProductFamily,
r.CURRENCY_CODE
FROM Entitlements_DWH r 
INNER JOIN accounts_sfdc a ON a.EnterpriseAccountID=r.USERID
WHERE
r.STATUS_NAME='Active' 
AND (r.END_DATE &gt; date('now') OR r.END_DATE IS NULL OR r.END_DATE = '') 
ORDER BY a.AccountName,r.EXT_PRODUCT_ID
;



SELECT 
	r.USERID,
	r.EXT_PRODUCT_ID,
	a.AccountName,
	'/////',
	r.ITEM_NAME,
	--r.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	r.QNTY_THRESHOLD,
	r.ProductFamily,
	'/////',
	o.ITEM_NAME,
	--o.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	o.QNTY_THRESHOLD,
	o.ProductFamily
FROM Entitlements_DWH r 
INNER JOIN Entitlements_DWH o ON o.EXT_PRODUCT_ID=r.EXT_PRODUCT_ID AND o.USERID=r.USERID
LEFT JOIN accounts_sfdc a ON a.EnterpriseAccountID=r.USERID
WHERE r.ProductFamily='Recurring'
AND o.ProductFamily='Overage'
AND r.STATUS_NAME='Active' 
AND (r.END_DATE &gt; date('now') OR r.END_DATE IS NULL OR r.END_DATE = '') 
AND o.STATUS_NAME='Active' 
AND (o.END_DATE &gt; date('now') OR o.END_DATE IS NULL OR o.END_DATE ='') 
AND r.QNTY_THRESHOLD != o.QNTY_THRESHOLD
AND r.ITEM_NAME NOT LIKE '%Bundle%'
AND  r.ITEM_NAME  NOT LIKE  '%France%'
;

SELECT 
	r.USERID,
	r.EXT_PRODUCT_ID,
	a.AccountName,
	'/////',
	r.ITEM_NAME,
	--r.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	r.QNTY_THRESHOLD,
	r.ProductFamily,
	'/////',
	o.ITEM_NAME,
	--o.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	o.QNTY_THRESHOLD,
	o.ProductFamily
FROM Entitlements_DWH r 
INNER JOIN Entitlements_DWH o ON  o.USERID=r.USERID AND (r.ITEM_NAME LIKE '%Domestic Minutes Bundle' AND o.ITEM_NAME='Domestic Minutes Overage')
LEFT JOIN accounts_sfdc a ON a.EnterpriseAccountID=r.USERID
WHERE r.ProductFamily='Recurring'
AND o.ProductFamily='Overage'
AND r.STATUS_NAME='Active' 
AND (r.END_DATE &gt; date('now') OR r.END_DATE IS NULL OR r.END_DATE = '') 
AND o.STATUS_NAME='Active' 
AND (o.END_DATE &gt; date('now') OR o.END_DATE IS NULL OR o.END_DATE ='') 
AND r.ITEM_NAME !=  'Contact Center: ' || 
	CASE WHEN o.QNTY_THRESHOLD =1000000 OR o.QNTY_THRESHOLD &gt;= 2000000 THEN (o.QNTY_THRESHOLD/1000000) || 'M ' || 
		CASE WHEN o.QNTY_THRESHOLD%1000000&gt;0  THEN (o.QNTY_THRESHOLD%1000000/1000) || 'K '  ELSE '' END
	ELSE   (o.QNTY_THRESHOLD/1000) || 'K '  END ||
	'Domestic Minutes Bundle'
;


select CASE WHEN 1000000=1000000 OR 1000000 &gt;= 2000000 THEN (1000000/1000000) || 'M ' || 
		CASE WHEN 1000000%1000000&gt;0  THEN (1000000%1000000/1000) || 'K '  ELSE ' ' END
	ELSE   (1000000/1000) || 'K '  END ||
	'Domestic Minutes Bundle'
	;
	
	
--2022-06-07

    SELECT DISTINCT
        b.EID,
        b.UID,
        b.BID,
        b.AccountName,
        e.EXT_PRODUCT_ID,
        lc.PRODUCT_NAME,
        e.ITEM_NAME,
        e.RETAIL_PRICE,
        e.MDURATION,
        e.CURRENCY_CODE,
        (e.RETAIL_PRICE-e.DISCOUNT_VALUE) / CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END,
        e.QNTY_THRESHOLD,
        lc.PRICE_USD,
        lc.PRICE_CAD,
        lc.PRICE_USD - (e.RETAIL_PRICE - e.DISCOUNT_VALUE) / CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END,
        lc.PRICE_CAD - (e.RETAIL_PRICE - e.DISCOUNT_VALUE) / CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END,
        lc.NIC_PRICE,
        lc.L_CATEGORY,
        lc.PARENT,
        e.ProductFamily,
        'test6'
    FROM 
        Entitlements_DWH e
    LEFT JOIN 
        BatchAccounts b 
        ON EID=USERID AND b.batchID='test6'
    LEFT JOIN 
    CatalogSFDC lc 
        ON (
            e.ITEM_NAME=lc.PRODUCT_NAME
 --               OR e.EXT_PRODUCT_ID IN (${&quot;'&quot; + Exc.join(&quot;', '&quot;) + &quot;'&quot;})
            )
            AND e.EXT_PRODUCT_ID=lc.SKU 
            AND (e.ProductFamily!='Overage' AND lc.PRODUCT_FAMILY!='Overage'
            OR e.ProductFamily='Overage' AND lc.PRODUCT_FAMILY='Overage')
  WHERE
        (END_DATE = '' OR END_DATE IS NULL OR END_DATE &gt; date('now')) 
        AND STATUS_NAME='Active'
		AND e.USERID='437089040'
    ORDER BY b.EID, e.EXT_PRODUCT_ID 
;


SELECT 
	r.USERID,
	r.EXT_PRODUCT_ID,
	a.AccountName,
	'/////',
	r.ITEM_NAME,
	--r.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	r.QNTY_THRESHOLD,
	r.TYPE_NAME,
	'/////',
	o.ITEM_NAME,
	--o.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	o.QNTY_THRESHOLD,
	o.TYPE_NAME
FROM EntitlementsAll r 
LEFT JOIN EntitlementsAll o ON o.EXT_PRODUCT_ID=r.EXT_PRODUCT_ID AND o.USERID=r.USERID
LEFT JOIN accounts_sfdc a ON a.EnterpriseAccountID=r.USERID
WHERE r.TYPE_NAME='Recurring'
AND o.TYPE_NAME='Overage'
AND r.STATUS_NAME='Active' 
AND (r.END_DATE &gt; date('now') OR r.END_DATE IS NULL OR r.END_DATE = '') 
AND o.STATUS_NAME='Active' 
AND (o.END_DATE &gt; date('now') OR o.END_DATE IS NULL OR o.END_DATE ='') 
AND r.QNTY_THRESHOLD != o.QNTY_THRESHOLD
AND r.ITEM_NAME NOT LIKE '%Bundle%'
AND  r.ITEM_NAME  NOT LIKE  '%France%'
UNION
SELECT 
	r.USERID,
	r.EXT_PRODUCT_ID,
	a.AccountName,
	'/////',
	r.ITEM_NAME,
	--r.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	r.QNTY_THRESHOLD,
	r.TYPE_NAME,
	'/////',
	o.ITEM_NAME,
	--o.RETAIL_PRICE - r.DISCOUNT_VALUE PRICE,
	o.QNTY_THRESHOLD,
	o.TYPE_NAME
FROM EntitlementsAll r 
INNER JOIN EntitlementsAll o ON  o.USERID=r.USERID AND (r.ITEM_NAME LIKE '%Domestic Minutes Bundle' AND o.ITEM_NAME='Domestic Minutes Overage')
LEFT JOIN accounts_sfdc a ON a.EnterpriseAccountID=r.USERID
WHERE r.TYPE_NAME='Recurring'
AND o.TYPE_NAME='Overage'
WHERE r.TYPE_NAME='Recurring'
AND o.TYPE_NAME='Overage'
AND r.STATUS_NAME='Active' 
AND (r.END_DATE &gt; date('now') OR r.END_DATE IS NULL OR r.END_DATE = '') 
AND o.STATUS_NAME='Active' 
AND (o.END_DATE &gt; date('now') OR o.END_DATE IS NULL OR o.END_DATE ='') 
AND (r.END_DATE &gt; date('now') OR r.END_DATE IS NULL OR r.END_DATE = '') 
AND o.STATUS_NAME='Active' 
AND (o.END_DATE &gt; date('now') OR o.END_DATE IS NULL OR o.END_DATE ='') 
AND r.ITEM_NAME !=  'Contact Center: ' || 
	CASE WHEN o.QNTY_THRESHOLD =1000000 OR o.QNTY_THRESHOLD &gt;= 2000000 THEN (o.QNTY_THRESHOLD/1000000) || 'M ' || 
		CASE WHEN o.QNTY_THRESHOLD%1000000&gt;0  THEN (o.QNTY_THRESHOLD%1000000/1000) || 'K '  ELSE '' END
	ELSE   (o.QNTY_THRESHOLD/1000) || 'K '  END ||
	'Domestic Minutes Bundle'
;

