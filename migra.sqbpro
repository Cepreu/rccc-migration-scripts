3" value="82"/><column index="34" value="65"/><column index="35" value="74"/><column index="36" value="67"/><column index="37" value="144"/><column index="38" value="136"/><column index="39" value="73"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="itbs_ngbs_maps" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="113"/><column index="2" value="353"/><column index="3" value="101"/><column index="4" value="99"/><column index="5" value="159"/><column index="6" value="33"/></column_widths><filter_values><column index="1" value="309-566-000"/><column index="2" value="Contact Center: Monthly Long-term Storage Retrieval (per GB)"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="nic_case_items" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="82"/><column index="2" value="82"/><column index="3" value="81"/><column index="4" value="58"/><column index="5" value="94"/><column index="6" value="300"/><column index="7" value="45"/><column index="8" value="47"/></column_widths><filter_values><column index="1" value="68936857004"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="nic_cases" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="88"/><column index="2" value="84"/><column index="3" value="82"/><column index="4" value="108"/><column index="5" value="129"/><column index="6" value="81"/><column index="7" value="110"/><column index="8" value="81"/><column index="9" value="300"/><column index="10" value="108"/><column index="11" value="80"/><column index="12" value="83"/><column index="13" value="61"/><column index="14" value="175"/><column index="15" value="107"/><column index="16" value="115"/><column index="17" value="118"/><column index="18" value="125"/><column index="19" value="64"/><column index="20" value="212"/><column index="21" value="73"/><column index="22" value="72"/></column_widths><filter_values><column index="1" value="68936857004"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">INSERT INTO nic_case_items ( accountID, BUID, sfdcCase, operation, skuid, sku, qtty, price ) VALUES 
	( &quot;68936857004&quot;, &quot;9900024&quot;, &quot;20420869&quot;, &quot;ADD&quot;, &quot;4107-1740-000&quot;, &quot;CXone Audio Recording Advanced Level Up (per Configured User)&quot;, 8.00, 2.10 ),
	( &quot;68936857004&quot;, &quot;9900024&quot;, &quot;20420869&quot;, &quot;ADD&quot;, &quot;12654-1705-000&quot;, &quot;CXone Voice Agent (per Configured User)&quot;, 8.00, 40.00 ),
	( &quot;68936857004&quot;, &quot;9900024&quot;, &quot;20420869&quot;, &quot;ADD&quot;, &quot;308-8-170&quot;, &quot;NICE inContact CXone Additional Configured Universal Port (Beyond 3 ports included)&quot;, 0.00, 22.50 ),
	( &quot;68936857004&quot;, &quot;9900024&quot;, &quot;20420869&quot;, &quot;ADD&quot;, &quot;309-566-000&quot;, &quot;NICE inContact CXone Long Term Storage Retrieval (per GB)&quot;, 0.00, 0.41 ),
	( &quot;68936857004&quot;, &quot;9900024&quot;, &quot;20420869&quot;, &quot;ADD&quot;, &quot;309-11-171&quot;, &quot;NICE inContact CXone Additional Active Storage (per GB)&quot;, 0.00, 0.30 ),
	( &quot;68936857004&quot;, &quot;9900024&quot;, &quot;20420869&quot;, &quot;ADD&quot;, &quot;309-565-000&quot;, &quot;NICE inContact CXone Long Term Storage (per GB)&quot;, 0.00, 0.03 );
	
	  WITH mapping AS (
        SELECT 
            CatalogSFDC.*,
            itbs_license_name,
            itbs_license_type,
            ngbs_license_id,
            ratio
        FROM itbs_ngbs_maps
        JOIN CatalogSFDC ON ngbs_license_id='CCL_'||L_CATEGORY||'_'||No
        WHERE ngbs_package_id=880
        )
        SELECT DISTINCT
                b.EID,
                b.UID,
                b.BID,
                b.AccountName,
                e.ID,
                e.EXT_PRODUCT_ID,
                lc.PRODUCT_NAME,
                e.ITEM_NAME,
                e.RETAIL_PRICE,
                e.MDURATION,
                e.CURRENCY_CODE,
                (e.RETAIL_PRICE-e.DISCOUNT) *1.0/ CASE WHEN e.ProductFamily!='Overage' THEN e.MDURATION ELSE 1 END,
                e.QNTY_THRESHOLD,
                e.QNTY_THRESHOLD * ratio,
                lc.PRICE_USD,
                lc.PRICE_CAD,
                lc.PRICE_USD - (e.RETAIL_PRICE - e.DISCOUNT) *1.0/ CASE WHEN e.ProductFamily!='Overage' THEN (e.MDURATION * ratio) ELSE 1 END AS discountUSD,
                lc.PRICE_CAD - (e.RETAIL_PRICE - e.DISCOUNT) *1.0/ CASE WHEN e.ProductFamily!='Overage' THEN (e.MDURATION * ratio) ELSE 1 END AS discountCA,
                lc.NIC_PRICE,
                lc.ngbs_license_id,
                lc.PARENT,
                e.ProductFamily,
                ratio
        FROM 
          Entitlements_DWH e
          INNER JOIN BatchAccounts b 
              ON EID=USERID AND b.batchID='Batch#1_Production'
          LEFT JOIN mapping lc 
              ON (
                UPPER(e.ITEM_NAME)=UPPER(lc.itbs_license_name)
                AND (e.EXT_PRODUCT_ID=lc.SKU OR e.EXT_PRODUCT_ID is null and lc.SKU is null)
                AND e.ProductFamily=lc.itbs_license_type
              )
        WHERE
		   b.EID=&quot;62377294004&quot; and EXT_PRODUCT_ID='4102-829-000' and
          STATUS_NAME='Active'
          AND (END_DATE = '' OR END_DATE IS NULL OR END_DATE &gt; date('now')) 
        ORDER BY b.EID, e.EXT_PRODUCT_ID  
;

select * from QTC_863_RCCC_Catalog 
where not exists (select  SKU from CatalogSFDC where NiceSKUID=SKU) and  NiceSKUID is not null 
order by NiceSKUID
;

select distinct EXT_PRODUCT_ID, ITEM_NAME, max(RETAIL_PRICE/MDURATION), CURRENCY_CODE  from Entitlements_DWH 
where not exists (select  SKU from CatalogSFDC where EXT_PRODUCT_ID=SKU) and  EXT_PRODUCT_ID is not null 
and CURRENCY_CODE in (&quot;CAD&quot;,&quot;USD&quot;)
group  by EXT_PRODUCT_ID,CURRENCY_CODE
order by EXT_PRODUCT_ID
;


select distinct EnterpriseAccountID PaymentPlan, MDURATION, batchID
from accounts_sfdc
join Entitlements_DWH on EnterpriseAccountID=USERID
left join BatchAccounts on EnterpriseAccountID=EID
where 
	STATUS_NAME='Active'
	and PaymentPlan='Monthly' and MDURATION=12 
order by batchID,EnterpriseAccountID
;


SELECT accountID, BUID, SUBSTR(nic_cases.Subject, 1, 16) AS subject, nic_cases.ProvisionDate, sfdcCase, operation AS oper, skuid, sku, qtty, price 
FROM nic_cases, nic_case_items WHERE nic_cases.UID='2300160005' AND nic_cases.CaseNumber=sfdcCase ORDER BY ProvisionDate DESC, cast(skuid as INTEGER) 
;
