"17" value="118"/><column index="18" value="125"/><column index="19" value="64"/><column index="20" value="300"/><column index="21" value="73"/><column index="22" value="118"/></column_widths><filter_values><column index="3" value="198044049"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">select * from RCCC_Empty_Email_Phone where not exists(select * from account_contact_info, accounts_sfdc where eid=EnterpriseAccountID and id=BillingID);


select a.*,s.AccountName
from 
RCCC_Empty_Email_Phone r
join accounts_sfdc s on r.id=s.BillingID
left join account_contact_info a on a.eid=s.EnterpriseAccountID
where a.email REGEXP &quot;^((?!@).)*$&quot;
or 
a.email is null;

select EID from account_contact_info group by EID having count(*)=1;

insert into account_contact_info select * from account_contact_info_backup;

update account_contact_info_backup  set EID=(SELECT EnterpriseAccountID FROM accounts_sfdc  WHERE EID=AccountName);

update BatchAccounts set batchID=&quot;Batch#3.2_Production&quot; where batchID=&quot;___Batch#3.2_Production&quot;;

SELECT *, 
CatalogID || '-' || CASE WHEN FeatureID='' OR FeatureID IS NULL THEN '000' ELSE FeatureID END || '-' || CASE WHEN FeatureDetailID='' OR FeatureDetailID IS NULL THEN '000' ELSE FeatureDetailID END AS SKU, 
CAST(Amount AS REAL)/Quantity AS Price FROM RCMRCSummary 
WHERE Account='4603742' 
AND BillingPeriodStart='2023-09-01' 
AND ProductType='MRC' 
ORDER BY cast(CatalogID as INTEGER), CatalogID 
;

SELECT CreatedDate, n.UID
FROM nic_cases n,BatchAccounts b
WHERE n.UID=b.EID AND b.batchID='Batch#1_Production'
ORDER BY CreatedDate
;


SELECT USERID, AccountName,sum(Amount) 
FROM  invoiceLines
JOIN accounts_sfdc ON USERID=EnterpriseAccountID
WHERE 
	PaymentPlan='Annual'
AND 
		BILLING_MONTH='2023-07-01'
AND 
	ITEMNAME NOT LIKE &quot;% Overage&quot; 
GROUP BY USERID
;



create table ttt  (n number);
delete from ttt;
