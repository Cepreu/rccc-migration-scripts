<plot_y_axes/><global_filter/></table><table schema="main" name="invoices" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="45"/><column index="2" value="83"/><column index="3" value="97"/><column index="4" value="56"/><column index="5" value="133"/><column index="6" value="114"/><column index="7" value="114"/><column index="8" value="113"/><column index="9" value="61"/><column index="10" value="86"/><column index="11" value="104"/><column index="12" value="67"/><column index="13" value="300"/><column index="14" value="127"/><column index="15" value="132"/><column index="16" value="124"/><column index="17" value="112"/><column index="18" value="137"/><column index="19" value="104"/><column index="20" value="91"/><column index="21" value="82"/><column index="22" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="nic_case_items" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="82"/><column index="2" value="57"/><column index="3" value="58"/><column index="4" value="58"/><column index="5" value="112"/><column index="6" value="300"/><column index="7" value="45"/><column index="8" value="47"/></column_widths><filter_values><column index="5" value="1012"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="nic_cases" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="85"/><column index="2" value="84"/><column index="3" value="83"/><column index="4" value="165"/><column index="5" value="254"/><column index="6" value="79"/><column index="7" value="113"/><column index="8" value="92"/><column index="9" value="300"/><column index="10" value="114"/><column index="11" value="80"/><column index="12" value="83"/><column index="14" value="372"/><column index="15" value="107"/><column index="16" value="115"/><column index="17" value="118"/><column index="18" value="160"/><column index="19" value="64"/><column index="20" value="300"/><column index="21" value="73"/><column index="22" value="118"/></column_widths><filter_values><column index="3" value="1543386020"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">--2022-04-10
select accountID, BUID, skuid, sku, sum(qtty),price 
from nic_case_items 
where BUID IN ('4596284', '4597578', '4595246')
GROUP BY accountID,skuid;


DELETE FROM Catalog;


SELECT 'test1', sf.EnterpriseAccountID, sf.BillingID, sf.inContactBUID, sf.AccountName, sf.brand, sf.PriceperseatCurrency FROM accounts_sfdc sf INNER JOIN nic_cases c2c ON c2c.UID=sf.EnterpriseAccountID 
WHERE 1=1 
AND sf.&quot;No.ofInContactSeats&quot; &lt; 10 
AND sf.brand='RingCentral' AND sf.OutboundTransport LIKE 'RC Ad-Hoc%' 
AND sf.EnterpriseAccountID NOT IN 
	(SELECT a.accountID from nic_case_items a WHERE skuid LIKE '1265_-%') 
GROUP BY UID 
HAVING 
	COUNT(c2c.UID) &gt;= 0 
	AND COUNT(c2c.UID) &lt;= 1 
	AND COUNT(CASE WHEN Subject LIKE 'NBU%' THEN 1 END) &gt;= 1
LIMIT 10;

drop table BatchDescription;

-- 2022-04-11
        SELECT
            b.EID,
            b.UID,
            b.BID,
            b.AccountName,
            e.CatID AS EXT_PRODUCT_ID,
            e.EntitlementName AS ITEM_NAME,
            e.Price AS RETAIL_PRICE,
            CASE WHEN e.ChargeTerm='Annual' THEN 12 ELSE 1 END  AS MDURATION,
            e.Currency AS CURRENCY_CODE,
            (e.Price-e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END AS OldPrice,
            e.QuantityOrThreshold AS QNTY_THRESHOLD,
            lc.PRICE_USD AS PriceUSD,
            lc.PRICE_CAD AS Price,
            lc.PRICE_USD - (e.Price - e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END AS DiscountUSD,
            lc.PRICE_CAD - (e.Price - e.Discount)  / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END AS Discount,
            lc.NIC_PRICE AS NiCPrice,
            lc.L_CATEGORY AS Category,
--            lc.Parent,
            e.ProductFamily
        FROM 
            Entitlements_SFDC e
        INNER JOIN 
            batch_items b 
            ON b.EID=e.EnterpriseAccountID AND b.batchID='test1'
        LEFT JOIN 
            CatalogSFDC lc
            ON (
                ITEM_NAME=lc.PRODUCT_NAME
                    OR EXT_PRODUCT_ID IN ('4100-701-000', '1503-693-000', '1503-694-000', '4109-673-000', '500-617-000', '308-8-167', '3465-1227-000')
                )
                AND EXT_PRODUCT_ID=lc.SKU 
                AND (e.ProductFamily!='Overage' AND lc.PRODUCT_FAMILY!='Overage'
                    OR e.ProductFamily='Overage' AND lc.PRODUCT_FAMILY='Overage')
           ORDER BY b.EID, EXT_PRODUCT_ID ;
		   
--2022-04-12
drop table invoices;

SELECT DISTINCT e.EID AS ENTERPRISE_ACCOUNT_ID, e.UID AS INCONTACT_BUID, e.BID AS BILLING_ID, e.AccountName, batchID, b.brand AS BRANDNAME, b.currency AS CURRENCY, 'MONTHLY' AS BILLING_TERM, 'LEGACY' AS CATALOG 
FROM
		batch_items b 
INNER JOIN 
		BATCH_test1_ents e ON b.EID=e.EID AND batchID='test1' 
ORDER BY e.AccountName
;

 SELECT 
	EXT_PRODUCT_ID, 
	Category, 
	ITEM_NAME, 
	QNTY_THRESHOLD, 
	OldPrice, 
	CASE CURRENCY_CODE WHEN 'USD' THEN round(PRICEUSD,2) WHEN 'CAD' THEN round(PRICE,2) END PRICE, 
	CASE CURRENCY_CODE WHEN 'USD' THEN round(DiscountUSD,2) WHEN 'CAD' THEN round(Discount,2) END DISCOUNT, 
	CURRENCY_CODE AS CURRENCY, 
	round(NiCPrice,2) NiCPrice, 
	ProductFamily, 
	'test1' AS batchID 
FROM BATCH_test1_ents 
WHERE eid='193257035' 
ORDER BY 
	AccountName, QNTY_THRESHOLD DESC, cast(EXT_PRODUCT_ID AS INTEGER), EXT_PRODUCT_ID, Category 
;


 SELECT 
	CatalogID || '-' || IFNULL(FeatureID,'000') || '-' || IFNULL(FeatureDetailID,'000') AS SKU, 
	Product, 
	Quantity, 
	Amount, 
	Amount/Quantity AS Price 
 FROM RCMRCSummary 
 WHERE 
	Account='4597680' 
AND 
	BillingPeriodStart='2022-02-01' 
AND 
	ProductType='MRC' 
 ORDER BY cast(CatalogID as INTEGER), CatalogID 
 ;
 
 SELECT SUBSTR(nic_cases.Subject, 1, 16) AS subject, nic_cases.ProvisionDate, sfdcCase,operation AS oper, skuid, sku, qtty, price FROM nic_cases, nic_case_items WHERE nic_cases.UID='193257035' AND nic_cases.CaseNumber=sfdcCase ORDER BY ProvisionDate DESC, cast(skuid as INTEGER) 
193257035 4597569 American Counseling Association
;


--2022-04-13

SELECT
    b.EID,
    b.UID,
    b.BID,
    b.AccountName,
    e.CatID AS EXT_PRODUCT_ID,
    e.EntitlementName AS ITEM_NAME,
    e.Price AS RETAIL_PRICE,
    CASE WHEN e.ChargeTerm='Annual' THEN 12 ELSE 1 END  AS MDURATION,
    e.Currency AS CURRENCY_CODE,
    (e.Price-e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END AS OldPrice,
    e.QuantityOrThreshold AS QNTY_THRESHOLD,
    lc.PRICE_USD AS PriceUSD,
    lc.PRICE_CAD AS Price,
    lc.PRICE_USD - (e.Price - e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END AS DiscountUSD,
    lc.PRICE_CAD - (e.Price - e.Discount)  / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END AS Discount,
    lc.NIC_PRICE AS NiCPrice,
    lc.L_CATEGORY AS Category,
    lc.PARENT,
    e.ProductFamily
FROM 
    Entitlements_SFDC e
INNER JOIN 
    batch_items b 
    ON b.EID=e.EnterpriseAccountID AND b.batchID='test1'
LEFT JOIN 
    CatalogSFDC lc
    ON (
        ITEM_NAME=lc.PRODUCT_NAME
            OR EXT_PRODUCT_ID IN ('4100-701-000', '1503-693-000', '1503-694-000', '4109-673-000', '500-617-000', '308-8-167', '3465-1227-000')
            OR ITEM_NAME = 'Contact Center: Monthly Overage for Long-term Storage (per GB)' AND lc.PRODUCT_NAME='Contact Center: Monthly Long-term Storage (per GB) Overage'
        )
        AND EXT_PRODUCT_ID=lc.SKU 
        AND (e.ProductFamily!='Overage' AND lc.PRODUCT_FAMILY!='Overage'
            OR e.ProductFamily='Overage' AND lc.PRODUCT_FAMILY='Overage')
   ORDER BY b.EID, EXT_PRODUCT_ID
   ;
   
   
   -- 2022-04-14
   
update Entitlements_SFDC set  EntitlementName = replace(EntitlementName, ' ? ', ' - ')   ;


-- 2022-04-25
  SELECT
      b.EID,
      b.UID,
      b.BID,
      b.AccountName,
      e.CatID,
      lc.PRODUCT_NAME,
      e.EntitlementName,
      e.Price,
      CASE WHEN e.ChargeTerm='Annual' THEN 12 ELSE 1 END,
      e.Currency AS CURRENCY_CODE,
      (e.Price-e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual' THEN 12 ELSE 1 END,
      e.QuantityOrThreshold,
      lc.PRICE_USD,
      lc.PRICE_CAD,
      lc.PRICE_USD - (e.Price - e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END,
      lc.PRICE_CAD - (e.Price - e.Discount)  / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual'  THEN 12 ELSE 1 END,
      lc.NIC_PRICE,
      lc.L_CATEGORY,
      lc.PARENT,
      e.ProductFamily,
      'test2'
  FROM 
      Entitlements_SFDC e
  INNER JOIN 
      batch_items b 
      ON b.EID=e.EnterpriseAccountID AND b.batchID='test2'
  LEFT JOIN 
      CatalogSFDC lc
      ON (
          e.EntitlementName=lc.PRODUCT_NAME
          )
          AND e.CatID=lc.SKU 
          AND (e.ProductFamily!='Overage' AND lc.PRODUCT_FAMILY!='Overage'
              OR e.ProductFamily='Overage' AND lc.PRODUCT_FAMILY='Overage')
	WHERE b.EID='2083092020'
    ORDER BY b.EID,  e.CatID
	;
	
	
	---- 2022-04-28
	
update CatalogSFDC set SKU=replace(SKU, ' ', '');
delete from BatchEntitlements where batchID='test5';

SELECT 
	b.EID, b.UID, b.BID, b.AccountName, e.CatID, lc.PRODUCT_NAME, e.EntitlementName, e.Price, 
	CASE WHEN e.ChargeTerm='Annual' THEN 12 ELSE 1 END, e.Currency AS CURRENCY_CODE, (e.Price-e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual' THEN 12 ELSE 1 END, 
	e.QuantityOrThreshold, lc.PRICE_USD, lc.PRICE_CAD, 
	lc.PRICE_USD - (e.Price - e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual' THEN 12 ELSE 1 END, 
	lc.PRICE_CAD - (e.Price - e.Discount) / CASE WHEN e.ProductFamily!='Overage' AND e.ChargeTerm='Annual' THEN 12 ELSE 1 END, 
l	c.NIC_PRICE, lc.L_CATEGORY, lc.PARENT, e.ProductFamily, 'test5' 
FROM Entitlements_SFDC e 
INNER JOIN BatchAccounts b 
ON b.EID=e.EnterpriseAccountID AND b.batchID='test5' 
LEFT JOIN CatalogSFDC lc 
ON ( e.EntitlementName=lc.PRODUCT_NAME OR e.CatID IN ('308-8-167', '309-11-171', '309-11-172', '309-565-000', '310-557-000', '500-617-000', '1032-173-000', '1032-174-000', '1032-175-000', '1032-487-000', '1032-493-000', '1032-494-000', '1032-572-000', '1500-000-000', '1503-693-000', '1503-694-000', '1561-55-000', '3465-22-000', '3465-521-000', '3465-1227-000', '4100-533-000', '4100-534-000', '4100-701-000', '4101-643-000', '4102-538-000', '4102-539-000', '4102-642-000', '4102-829-000', '4104-541-000', '4105-542-000', '4104-644-000', '4107-645-000', '4108-561-000', '4109-673-000', '610064-302-000') ) 
AND e.CatID=lc.SKU 
AND (e.ProductFamily!='Overage' AND lc.PRODUCT_FAMILY!='Overage' OR e.ProductFamily='Overage' AND lc.PRODUCT_FAMILY='Overage') 
ORDER BY b.EID, e.CatID
;


          SELECT DISTINCT a.accountID 
          FROM nic_case_items a 
          WHERE 
            (skuid LIKE '1265_-%' OR 
            skuid LIKE '510-13%' OR 
            skuid IN ('4100-1713-000', '4108-1716-000', '1440-1340-000', '3350-1155-000'))
			and accountID='62941575028'
			;
			
			
			
