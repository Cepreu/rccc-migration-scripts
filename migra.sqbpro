--2022-05-03
--INSERT OR REPLACE INTO BatchAccounts (batchID, EID, BID, UID, AccountName, brand, currency) 
SELECT 'problematic', sf.EnterpriseAccountID, sf.BillingID, sf.inContactBUID, sf.AccountName, sf.brand, sf.PriceperseatCurrency 
FROM accounts_sfdc sf 
INNER JOIN nic_cases c2c ON c2c.UID=sf.EnterpriseAccountID 
WHERE 1=1 
--AND sf.&quot;No.ofInContactSeats&quot; &lt; 1000 
--AND sf.brand='RingCentral' 
--AND sf.OutboundTransport LIKE 'RC Ad-Hoc%' 
-- AND sf.EnterpriseAccountID NOT IN ( 
-- 	SELECT DISTINCT a.accountID 
-- 	FROM nic_case_items a 
-- 	WHERE skuid LIKE '1265_-%' OR skuid LIKE '510-13%' OR skuid IN ('4100-1713-000', '4102-1710-000', '4108-1716-000', '1440-1340-000', '1440-1341-000', '3350-1155-000', '3350-1157-000')) 
AND sf.EnterpriseAccountID IN (1781004027) 
AND NOT EXISTS ( 
	SELECT * FROM BatchAccounts bi 
	WHERE sf.EnterpriseAccountID=bi.EID 
) 
GROUP BY UID 
HAVING COUNT(c2c.UID) &gt;= 0 AND COUNT(c2c.UID) &lt;= 100 
LIMIT 2000
;</sql><current_tab id="0"/></tab_sql></sqlb_project>
